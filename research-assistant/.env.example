# Copy to .env and edit as needed. Every setting has a working local default,
# so an empty .env is fine. No API keys are involved anywhere.

# --- Ollama (local inference; must support tool calling for the agent) -------
# qwen2.5:3b (~2 GB) is the default because it fits a 8 GB machine alongside
# Weaviate. On 16 GB+ use llama3.1:8b or qwen2.5:7b for better synthesis.
RA_OLLAMA_BASE_URL=http://localhost:11434
RA_LLM_MODEL=qwen2.5:3b
RA_EMBEDDING_MODEL=nomic-embed-text
RA_LLM_TEMPERATURE=0.0
RA_REQUEST_TIMEOUT=300

# --- Weaviate ---------------------------------------------------------------
RA_WEAVIATE_HOST=localhost
RA_WEAVIATE_HTTP_PORT=8080
RA_WEAVIATE_GRPC_PORT=50051
RA_COLLECTION_NAME=ResearchPaperChunk
# Weaviate's RAFT node name. It must not change once a volume holds data, or the
# node cannot rejoin its own cluster and never becomes ready. Only set this on a
# fresh volume; changing it later needs `docker compose down -v` + re-ingest.
# RA_WEAVIATE_NODE_NAME=ddd759283b32

# --- Chunking & retrieval ---------------------------------------------------
RA_CHUNK_SIZE=1200
RA_CHUNK_OVERLAP=200
RA_RETRIEVAL_K=5
RA_RETRIEVAL_FETCH_K=20
RA_MAX_AGENT_ITERATIONS=6

# --- Paths ------------------------------------------------------------------
# Defaults to <repo>/data. Only set this if you keep papers elsewhere, and use an
# absolute path: a relative one resolves against your current directory, not the
# repo root. Inside docker compose this is set to /app/data for you.
# RA_DATA_DIR=/home/me/papers
